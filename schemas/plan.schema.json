{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/robot-task-planner/plan.schema.json",
  "title": "Constrained Robot Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "goal", "steps"],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/navigate"
          },
          {
            "$ref": "#/$defs/find"
          },
          {
            "$ref": "#/$defs/pick"
          },
          {
            "$ref": "#/$defs/place"
          },
          {
            "$ref": "#/$defs/open"
          },
          {
            "$ref": "#/$defs/close"
          }
        ]
      }
    }
  },
  "$defs": {
    "navigate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "navigate" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["location"],
          "properties": {
            "location": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "find": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "find" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object"],
          "properties": {
            "object": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "pick" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object"],
          "properties": {
            "object": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "place" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object", "location"],
          "properties": {
            "object": { "type": "string", "minLength": 1 },
            "location": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "open" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container"],
          "properties": {
            "container": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "arguments"],
      "properties": {
        "action": { "const": "close" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container"],
          "properties": {
            "container": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
